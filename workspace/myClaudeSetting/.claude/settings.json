{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Korean",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git log * )",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__context7"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-build-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git merge*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-push-build-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash(./gradlew*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/build-error-logger.sh"
          }
        ]
      }
    ]
  }
}
